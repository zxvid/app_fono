package com.example.FonoSalud.service;
import java.text.DecimalFormat;
import java.util.logging.Logger;

import weka.core.DenseInstance;
import weka.core.Instance;
import weka.core.Instances;
import weka.classifiers.Classifier;
import weka.core.converters.ConverterUtils.DataSource;

import org.springframework.core.io.ClassPathResource;
import org.springframework.stereotype.Service;
import org.springframework.beans.factory.annotation.Autowired;
import jakarta.annotation.PostConstruct;

import com.example.FonoSalud.model.CitasMedicasData;
import com.example.FonoSalud.repository.CitasMedicasDataRepository;
import com.example.FonoSalud.service.dto.PrediccionCitasMedicas;


@Service
public class CitasMedicasService {

    private static final Logger LOGGER = Logger.getLogger(CitasMedicasService.class.getName());
    private Classifier classifier;
    private Instances dataStructure;
    
    @Autowired
    private CitasMedicasDataRepository repository;

    @PostConstruct
    public void init() {
        try {
            ClassPathResource modelResource = new ClassPathResource("citasprueba2.model");
            classifier = (Classifier) weka.core.SerializationHelper.read(modelResource.getInputStream());
            LOGGER.info("Modelo citasprueba cargado exitosamente.");

            ClassPathResource arffResource = new ClassPathResource("citas_medicas.arff");
            DataSource source = new DataSource(arffResource.getInputStream());
            dataStructure = source.getDataSet();
            dataStructure.setClassIndex(dataStructure.numAttributes() - 1);
            LOGGER.info("Estructuras citas_medicas.arff cargada exitosamente");
        } catch (Exception e) {
            LOGGER.severe("Error al inicializar PredictionService: " + e.getMessage());
            // Do not throw, set to null
            classifier = null;
            dataStructure = null;
        }
    }

    public PrediccionCitasMedicas predictAndSave(CitasMedicasData datos) {
        if (classifier == null || dataStructure == null) {
            LOGGER.severe("Classifier or dataStructure not initialized");
            return new PrediccionCitasMedicas("Error", "0");
        }
        LOGGER.info("Datos recibidos: " + datos.toString());
        try {
            Instance instance = new DenseInstance(15);
            instance.setDataset(dataStructure);

            instance.setValue(0, datos.getId());
            instance.setValue(1, datos.getEdad());
            instance.setValue(3, datos.getFecha_cita()); 
            instance.setValue(4, datos.getHora_cita());
            instance.setValue(5, dataStructure.attribute(5).indexOfValue(datos.getDia_semana()));
            instance.setValue(6, datos.getAnticipacion());
            instance.setValue(7, datos.getEspecialidad_medica());
            instance.setValue(8, datos.getFonoaudiologo_asignado());
            instance.setValue(9, datos.getCitas_previas());
            instance.setValue(10, datos.getCitas_canceladas());
            instance.setValue(11, datos.getMotivo_cita());
            instance.setValue(12, dataStructure.attribute(12).indexOfValue(datos.getMedio_reserva()));
            instance.setValue(13, dataStructure.attribute(13).indexOfValue(datos.getRecordatorio_enviado()));
    
            LOGGER.info("✅ Instancia creada con éxito: " + instance);
    
            double predictionValue = classifier.classifyInstance(instance);
            String prediction = dataStructure.classAttribute().value((int) predictionValue);
    
            double[] probabilities = classifier.distributionForInstance(instance);
            double confidence = probabilities[(int) predictionValue];
    
            DecimalFormat df = new DecimalFormat("#.#");
            String confidencePercentage = df.format(confidence * 100) + "%";
    
            datos.setResultadoPrediccion(prediction);
            repository.save(datos);
    
            return new PrediccionCitasMedicas(prediction, confidencePercentage);
        } catch (Exception e) {
            logError("Error al hacer la predicción", e);
            return new PrediccionCitasMedicas("Error", "0");
        }
    }
    

    public void logError(String message, Exception e) {
        LOGGER.severe(message + ": " + e.getMessage());
        e.printStackTrace(); 
    }
    
}
