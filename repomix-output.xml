package com.example.FonoSalud.service;

import java.util.List;


import com.example.FonoSalud.model.Cita;
import com.example.FonoSalud.model.Patologia;
import com.example.FonoSalud.repository.CitaRepository;
import com.example.FonoSalud.repository.PatologiaRepository;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

import com.example.FonoSalud.model.Diagnostico;
import com.example.FonoSalud.repository.DiagnosticoRepository;

import jakarta.transaction.Transactional;

@Service
public class DiagnosticoService {
	
	@Autowired
    DiagnosticoRepository diagnosticoRepository;
    @Autowired
    CitaRepository citaRepository;
    @Autowired
    PatologiaRepository patologiaRepository;

    @Transactional
    public Diagnostico createDiagnostico(Diagnostico diagnostico) {
        Cita cita = citaRepository.findById(diagnostico.getCita().getId()).orElseThrow(() -> new RuntimeException("Cita no encontrada"));
        Patologia patologia = patologiaRepository.findById(diagnostico.getPatologia().getId()).orElseThrow(() -> new RuntimeException("Patología no encontrada"));

        diagnostico.setCita(cita);
        diagnostico.setPatologia(patologia);

        Diagnostico savedDiagnostico = diagnosticoRepository.save(diagnostico);
        return savedDiagnostico;
    }

    public List<Diagnostico> getDiagnosticos() {
        return diagnosticoRepository.findAll();
    }

    public Diagnostico getDiagnostico(Long id) {
        return diagnosticoRepository.findById(id).orElseThrow();
    }

    @Transactional
    public Diagnostico updateDiagnostico(Long id, Diagnostico request) {
        Diagnostico diagnostico = diagnosticoRepository.findById(id).orElseThrow();

        diagnostico.setComentario(request.getComentario());

        return diagnosticoRepository.save(diagnostico);
    }

    public void deleteDiagnostico(Long id) {
        diagnosticoRepository.deleteById(id);
    }
}
