package com.example.FonoSalud.service;

import java.util.List;
import java.util.Optional;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.security.core.context.SecurityContextHolder;
import org.springframework.stereotype.Service;

import org.slf4j.Logger;
import org.slf4j.LoggerFactory;

import com.example.FonoSalud.exceptions.DateNotAllowed;
import com.example.FonoSalud.model.Cita;
import com.example.FonoSalud.model.User;
import com.example.FonoSalud.model.DTO.CitaDTO;
import com.example.FonoSalud.repository.CitaRepository;
import com.example.FonoSalud.repository.UserRepository;
import org.springframework.security.core.Authentication;

@Service
public class CitaService {

    @Autowired
    private CitaRepository citaRepository;

    @Autowired
    private UserRepository userRepository;

    private static final Logger logger = LoggerFactory.getLogger(CitaService.class);
    

    public Cita createCita(CitaDTO citaDTO) {
        logger.info("Iniciando creación de una nueva cita con datos: {}", citaDTO);

        // Obtener el usuario autenticado
        Authentication auth = SecurityContextHolder.getContext().getAuthentication();
        String username = auth.getName(); // Devuelve el nombre de usuario (por defecto)
        User usuarioAutenticado = userRepository.findByUser(username)
        .orElseThrow(() -> new RuntimeException("Usuario no encontrado"));

        // Crear la cita usando el DTO, pero asignando al fonoaudiologo
        Cita nuevaCita = new Cita();
        Optional<User> fonoaudiologo = userRepository.findById(citaDTO.getIdFonoaudiologo());
        nuevaCita.setIdPaciente(usuarioAutenticado);
        nuevaCita.setIdFonoaudiologo(fonoaudiologo.get());
        nuevaCita.setSintomas(citaDTO.getSintomas());
        nuevaCita.setFecha_hora(citaDTO.getFecha_hora());

        // Verificar si ya hay una cita con la misma fecha y hora para ese fonoaudiologo
        List<Cita> citas = citaRepository.findByIdFonoaudiologo(fonoaudiologo.get());
        for (Cita citaExistente : citas) {
            if (citaExistente.getFecha_hora().equals(nuevaCita.getFecha_hora())) {
                throw new DateNotAllowed("El fonoaudiologo ya tiene asignada una cita con esa fecha y hora");
            }
        }

        // Guardar la nueva cita
        return citaRepository.save(nuevaCita);
    }


    public List<Cita> getCitas() {
        return citaRepository.findAll();
    }

    public List<Cita> getCitasByFonoaudiologo(){
        // Obtener el usuario autenticado
        Authentication auth = SecurityContextHolder.getContext().getAuthentication();
        String username = auth.getName(); // Devuelve el nombre de usuario (por defecto)
        User usuarioAutenticado = userRepository.findByUser(username)
                .orElseThrow(() -> new RuntimeException("Usuario no encontrado"));

        return citaRepository.findByIdFonoaudiologo(usuarioAutenticado);
    }

    public List<Cita> getCitasByPaciente(){
        // Obtener el usuario autenticado
        Authentication auth = SecurityContextHolder.getContext().getAuthentication();
        String username = auth.getName(); // Devuelve el nombre de usuario (por defecto)
        User usuarioAutenticado = userRepository.findByUser(username)
                .orElseThrow(() -> new RuntimeException("Usuario no encontrado"));

        return citaRepository.findByIdPaciente(usuarioAutenticado);
    }

    public Cita getCitaById(Long id) {
        return citaRepository.findById(id).orElseThrow(() -> new RuntimeException("Cita no encontrada"));
    }

    public Cita updateCita(Cita cita) {
        return citaRepository.save(cita);
    }

    public void deleteCita(Long id) {
        citaRepository.deleteById(id);
    }

    // Método para obtener citas por ID de usuario (usado por IAChatService)
    public List<Cita> getCitasByUserId(Long userId) {
        Optional<User> user = userRepository.findById(userId);
        if (user.isPresent()) {
            return citaRepository.findByIdPaciente(user.get());
        }
        return List.of();
    }
}
