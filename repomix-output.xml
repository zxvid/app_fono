package com.example.FonoSalud.service;


import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.context.annotation.Lazy;
import org.springframework.security.authentication.AuthenticationManager;
import org.springframework.security.authentication.UsernamePasswordAuthenticationToken;
import org.springframework.security.crypto.password.PasswordEncoder;
import org.springframework.stereotype.Service;

import com.example.FonoSalud.model.Rol;
import com.example.FonoSalud.model.User;
import com.example.FonoSalud.model.DTO.AuthenticationResponseDTO;
import com.example.FonoSalud.model.DTO.LoginDTO;
import com.example.FonoSalud.model.DTO.RegisterDTO;
import com.example.FonoSalud.repository.UserRepository;

import java.util.HashMap;
import java.util.Map;

@Service
public class AuthenticationServiceImpl {

    @Lazy
    @Autowired
    private AuthenticationManager authenticationManager;

    @Autowired
    private UserRepository iUserRepository;

    @Autowired
    private JwtService jwtService;

    @Autowired
    private PasswordEncoder passwordEncoder;

    
    public AuthenticationResponseDTO login(LoginDTO login) {
        UsernamePasswordAuthenticationToken authToken = new UsernamePasswordAuthenticationToken(login.getUsername(), login.getPassword());

        authenticationManager.authenticate(authToken);

        User user = iUserRepository.findByUser(login.getUsername()).get();

        String jwt = jwtService.generateToken(user, generateExtraClaims(user));

        return new AuthenticationResponseDTO(jwt);
    }

    
    public Map<String, Object> generateExtraClaims(User user) {
        Map<String, Object> extraClaims = new HashMap<>();
        extraClaims.put("name", user.getUsername());
        extraClaims.put("role", user.getRole().name());
        return extraClaims;
    }

    
      public AuthenticationResponseDTO register(RegisterDTO register) {
          User user = new User();
          user.setNombre(register.getNombre());
          user.setUser(register.getUser());
          user.setContrasena(passwordEncoder.encode(register.getContrasena()));
          user.setRole(Rol.valueOf("USER"));

          iUserRepository.save(user);

          UsernamePasswordAuthenticationToken authToken = new UsernamePasswordAuthenticationToken(register.getUser(), register.getContrasena());

          authenticationManager.authenticate(authToken);

          User userRegister = iUserRepository.findByUser(register.getUser()).get();

          String jwt = jwtService.generateToken(userRegister, generateExtraClaims(user));

          return new AuthenticationResponseDTO(jwt);

      }
}
